function pack(rows: Array<string>): Map<string, string> {
  const map = new Map<string, string>();
  for (let i = 0; i < rows.length; i += 2) {
    map.set(rows[i], rows[i + 1]);
  }
  return map;
}

export function languageFromTag(tag: string): string {
  const lower = tag.toLowerCase();
  if (lower.indexOf('vi') === 0) {
    return 'vi';
  }
  if (lower.indexOf('zh') === 0) {
    return 'zh';
  }
  if (lower.indexOf('ja') === 0) {
    return 'ja';
  }
  return 'en';
}

export function phrase(lang: string, key: string): string {
  const table = lang === 'en' ? EN : (lang === 'zh' ? ZH : (lang === 'ja' ? JA : VI));
  const value = table.get(key);
  if (value !== undefined) {
    return value;
  }
  const fallback = EN.get(key);
  return fallback !== undefined ? fallback : key;
}
